# Copy to .env.local for local development, and set the same vars in Vercel.
# Values below are for the Supabase project this portal targets.

# Public (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://hgnxpvykqcvnqlhjhhgy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Server-only (NEVER expose to the browser). Used by server actions.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Live room occupancy from the Hamsun-PMS database (optional).
# The portal reads only the sanitized `portal_room_occupancy` view
# (branch + room + Occupied/Vacant/Blocked — no guest data), so the PMS
# publishable/anon key is enough. When unset, occupancy shows "—".
PMS_SUPABASE_URL=https://zanpnhfcuqznmmokbchv.supabase.co
PMS_SUPABASE_KEY=sb_publishable_your_pms_publishable_key
